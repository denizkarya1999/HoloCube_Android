    <!-- Guide dialog -->
    <string name="guide_title">HoloCube Guide</string>
    <string name="guide_text">Start Inference: run YOLO26 on live camera frames and draw labelled boxes with confidence percentages.\n\nRecord: save a data-collection MP4 with microphone audio to Movies/HoloCube. Tap Stop to finish.\n\nSnapshot: detect objects in one frame and freeze it. Press C to resume the live camera.\n\n+ / −: zoom. ↺: switch camera. C: clear results.\n\nSettings: confidence threshold, number of boxes, and PyTorch CPU threads.\n\nThe original yolo26n.pt checkpoint runs on this phone with embedded Python and PyTorch. No server or model download is needed.</string>
    <string name="ok">OK</string>

