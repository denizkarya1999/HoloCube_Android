<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkBlue"
    android:padding="16dp"
    tools:context=".AboutHoloCubeActivity">

    <!-- Title Bar (Icon + Title) -->
    <LinearLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/darkBlue"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Icon (ImageButton) -->
        <ImageButton
            android:id="@+id/iconImageButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@android:color/transparent"
            android:src="@drawable/holocube"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/logo_description" />

        <!-- Title Text -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/holocube"
            android:textSize="44sp"
            android:textColor="@color/yellow"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="0dp" />
    </LinearLayout>

    <!-- Details container: scrolls on short screens -->
    <ScrollView
        android:id="@+id/details_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/title_container"
        app:layout_constraintBottom_toTopOf="@id/umLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/details_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/yellow"
            android:padding="16dp">

            <!-- Header Text -->
            <TextView
                android:id="@+id/detailsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_header"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/darkBlue"
                android:layout_gravity="center_horizontal"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/textViewEdition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_designed_for"
                android:textColor="@color/darkBlue" />

            <TextView
                android:id="@+id/textViewVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_version"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textViewPlatform"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_platform"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textViewReleaseDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_release_date"
                android:textColor="@color/darkBlue" />

            <TextView
                android:id="@+id/textViewDevelopers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_developers"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textViewProfessor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_advisor"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textViewLab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_lab"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textViewUniversity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_university"
                android:textColor="@color/darkBlue"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

    <!-- UofM Logo with smaller dimensions, placed at the bottom -->
    <ImageView
        android:id="@+id/umLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/umlogo"
        android:contentDescription="@string/um_logo_description"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/details_scroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
