<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Adjustable confidence plus the model's CPU thread count -->
    <PreferenceCategory
        android:title="Settings"
        android:layout="@layout/preference_category_layout">

        <SeekBarPreference
            android:key="confidence_threshold"
            android:layout="@layout/preference_seekbar_layout"
            android:title="Confidence Thresholds"
            android:summary="Minimum confidence in percent. Below it, no transmitter box or orientation triangle is shown."
            android:defaultValue="35"
            android:max="100"
            app:min="5"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true" />

        <ListPreference
            android:key="cpu_threads"
            android:layout="@layout/preference_list_layout"
            android:title="PyTorch CPU threads"
            android:summary="%s used by the embedded PyTorch runtime"
            android:entries="@array/cpu_thread_options"
            android:entryValues="@array/cpu_thread_values"
            android:defaultValue="4" />

        <ListPreference
            android:key="orientation_detection"
            android:layout="@layout/preference_list_layout"
            android:title="Orientation Detection"
            android:summary="%s · runs the Orientation Detection Model whenever a transmitter is detected (640 × 640 input, slower)"
            android:entries="@array/orientation_options"
            android:entryValues="@array/orientation_values"
            android:defaultValue="on" />
    </PreferenceCategory>

    <!-- Model testing without the camera: run a model on an image stored on this phone -->
    <PreferenceCategory
        android:title="Model Testing"
        android:layout="@layout/preference_category_layout">

        <Preference
            android:key="local_file_inference"
            android:layout="@layout/preference_list_layout"
            android:title="In-Device Local File Inference"
            android:summary="Open a test image from this phone and run the Transmitter Detection Model or the Orientation Detection Model on it." />
    </PreferenceCategory>

</PreferenceScreen>
