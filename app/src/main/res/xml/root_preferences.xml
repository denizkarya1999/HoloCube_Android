<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The Quest Settings page: adjustable confidence, fixed box count, plus the model's CPU thread count -->
    <PreferenceCategory
        android:title="Settings"
        android:layout="@layout/preference_category_layout">

        <SeekBarPreference
            android:key="confidence_threshold"
            android:layout="@layout/preference_seekbar_layout"
            android:title="Confidence Thresholds"
            android:summary="Minimum confidence in percent. Below it, no transmitter box is shown."
            android:defaultValue="35"
            android:max="100"
            app:min="5"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true" />

        <!-- The transmitter pipeline always keeps only the strongest valid detection. -->
        <Preference
            android:key="max_detections_fixed"
            android:layout="@layout/preference_list_layout"
            android:title="Number of boxes (fixed)"
            android:summary="1: the highest-confidence Transmitter above the threshold"
            android:selectable="false"
            android:persistent="false" />

        <ListPreference
            android:key="cpu_threads"
            android:layout="@layout/preference_list_layout"
            android:title="PyTorch CPU threads"
            android:summary="%s used by the embedded PyTorch runtime"
            android:entries="@array/cpu_thread_options"
            android:entryValues="@array/cpu_thread_values"
            android:defaultValue="4" />
    </PreferenceCategory>

</PreferenceScreen>
